{
  "servers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/app/workspace"],
      "tools": [
        {"name": "read_file", "description": "Read a file from workspace"},
        {"name": "write_file", "description": "Write a file to workspace"},
        {"name": "list_directory", "description": "List directory contents"}
      ]
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"],
      "tools": [
        {"name": "fetch", "description": "Fetch content from a URL"}
      ]
    }
  }
}
