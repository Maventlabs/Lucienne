# ============================================
# Lucienne Nightfall — Environment Variables
# ============================================

# Telegram (REQUIRED)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
AUTHORIZED_USER_ID=your_telegram_user_id_here

# LLM (REQUIRED)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# GitHub (OPTIONAL — for repo operations)
GITHUB_TOKEN=

# 9Router / AIOS (OPTIONAL)
NINEROUTER_BASE_URL=http://host.docker.internal:20128/v1
NINEROUTER_API_KEY=

# Safety (OPTIONAL)
# CONFIRMATION_MODE=true
# MAX_ITERATIONS=10
WORKSPACE_DIR=./workspace